# Copy this file to .env and fill in real values. Never commit .env.

# Supabase → Project Settings → API. Use the anon/public key ONLY.
# Never put the service_role key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Google Cloud → Maps SDK for Android. Only needed for EAS builds (Expo Go ignores it).
# Restrict it to package com.kennynauna.messupdate + your signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY=your-google-maps-android-key
